{
  "openapi": "3.0.3",
  "info": {
    "title": "Flutter Algorithm Server — Existing Chords + Proposed Separation",
    "version": "1.0.0-handoff",
    "description": "Source audit: 2026-10-27. This combined specification documents existing chord routes and a NEW separation adapter contract. proposed-not-implemented operations do not exist yet. No service deployment or real-model integration test was performed. No authentication is currently implemented in chord-engine; production identity/ownership enforcement must be supplied by the business gateway. See FLUTTER_ALGORITHM_API.md for source discrepancies."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Development placeholder only; not a verified running server"
    }
  ],
  "tags": [
    {
      "name": "chords",
      "description": "Existing chord-engine HTTP routes"
    },
    {
      "name": "health",
      "description": "Existing chord-engine health routes"
    },
    {
      "name": "separation",
      "description": "Proposed HTTP adapter; implementation required"
    }
  ],
  "paths": {
    "/api/v1/jobs": {
      "post": {
        "x-implementation-status": "existing",
        "tags": [
          "chords"
        ],
        "summary": "Upload audio for chord recognition",
        "operationId": "createChordJob",
        "parameters": [
          {
            "name": "smooth_method",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "hmm",
                "median"
              ],
              "default": "hmm"
            },
            "description": "Chord smoothing"
          },
          {
            "name": "device",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "cpu",
                "cuda"
              ],
              "default": "cpu"
            },
            "description": "Existing public option; cached detector does not switch per request"
          },
          {
            "name": "include_raw_chords",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include raw frame labels"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "audio"
                ],
                "properties": {
                  "audio": {
                    "type": "string",
                    "format": "binary",
                    "description": "MP3/WAV/FLAC/OGG/M4A; max 52,428,800 bytes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "unsupported_format or invalid_file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "file_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "validation_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "internal_server_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/status": {
      "get": {
        "x-implementation-status": "existing",
        "tags": [
          "chords"
        ],
        "summary": "Poll chord job status",
        "operationId": "getChordStatus",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Opaque job ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Includes failed jobs as HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChordStatus"
                }
              }
            }
          },
          "404": {
            "description": "job_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "internal_server_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/result": {
      "get": {
        "x-implementation-status": "existing",
        "tags": [
          "chords"
        ],
        "summary": "Fetch completed chord analysis",
        "operationId": "getChordResult",
        "description": "Current output is on a silence-trimmed timeline; no beats field; confidence defaults to 1.0. See handoff document before playback synchronization.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Opaque job ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Chord analysis result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChordResult"
                }
              }
            }
          },
          "404": {
            "description": "job_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "job_not_complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "processing_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "internal_server_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "x-implementation-status": "existing",
        "tags": [
          "health"
        ],
        "summary": "Existing chord service health",
        "operationId": "getChordHealth",
        "responses": {
          "200": {
            "description": "Process health, not verified model readiness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ping": {
      "get": {
        "x-implementation-status": "existing",
        "tags": [
          "health"
        ],
        "summary": "Liveness ping",
        "operationId": "ping",
        "responses": {
          "200": {
            "description": "Pong",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ping"
                  ],
                  "properties": {
                    "ping": {
                      "type": "string",
                      "enum": [
                        "pong"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/separation/jobs": {
      "post": {
        "x-implementation-status": "proposed-not-implemented",
        "tags": [
          "separation"
        ],
        "summary": "Upload audio for separation (to implement)",
        "operationId": "createSeparationJob",
        "description": "New adapter contract. Max 50 MiB; decoded duration 2–600 seconds checked in background. Server chooses device and fixed default model. Converts upload to an isolated WAV folder before Session.infer().",
        "parameters": [
          {
            "name": "output_format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "wav_s16",
                "wav_float32",
                "flac16"
              ],
              "default": "wav_s16"
            },
            "description": "Explicit wrapper default; library default remains wav_float32"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "audio"
                ],
                "properties": {
                  "audio": {
                    "type": "string",
                    "format": "binary",
                    "description": "MP3/WAV/FLAC/OGG/M4A; max 52,428,800 bytes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "unsupported_format or invalid_file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "file_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "validation_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "queue_full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Retry delay in seconds",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "500": {
            "description": "internal_server_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "model_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
